---
import ProductLayout from "../../layouts/product-layout.astro";
import Container from "../../components/ui/container.astro";
import SectionHeading from "../../components/ui/section-heading.astro";
import { icons, withSize } from "../../config/icons";
import { useTranslations } from "../../i18n/utils";

const lang = "en" as const;
const t = useTranslations(lang);

const starters = [
    {
        name: t.starters.nextjs.name,
        slug: "nextjs",
        description: t.starters.nextjs.description,
        github: "https://github.com/rush-cms/nextjs-starter",
        status: "available",
        features: ["App Router", "TypeScript", "Tailwind CSS", "Rush SDK"],
        icon: withSize(icons.nextjs, 24),
    },
    {
        name: t.starters.astro.name,
        slug: "astro",
        description: t.starters.astro.description,
        github: "#",
        status: "coming-soon",
        features: [
            "Astro 5",
            "Content Collections",
            "Tailwind CSS",
            "Rush SDK",
        ],
        icon: withSize(icons.astro, 24),
    },
];

const features = [
    {
        title: t.starters.features.production.title,
        description: t.starters.features.production.description,
        icon: withSize(icons.check, 20),
    },
    {
        title: t.starters.features.sdk.title,
        description: t.starters.features.sdk.description,
        icon: withSize(icons.terminal, 20),
    },
    {
        title: t.starters.features.typescript.title,
        description: t.starters.features.typescript.description,
        icon: withSize(icons.code, 20),
    },
    {
        title: t.starters.features.tailwind.title,
        description: t.starters.features.tailwind.description,
        icon: withSize(icons.palette, 20),
    },
    {
        title: t.starters.features.seo.title,
        description: t.starters.features.seo.description,
        icon: withSize(icons.chart, 20),
    },
    {
        title: t.starters.features.components.title,
        description: t.starters.features.components.description,
        icon: withSize(icons.blocks, 20),
    },
];
---

<ProductLayout
    title={t.starters.title}
    tagline={t.starters.tagline}
    description={t.starters.description}
    githubUrl="https://github.com/rush-cms"
    icon={withSize(icons.rocket, 40)}
    features={features}
    lang={lang}
>
    <section class="py-16 border-t border-white/5">
        <Container>
            <SectionHeading>{t.starters.templatesTitle}</SectionHeading>

            <div
                class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto"
            >
                {
                    starters.map((starter) => (
                        <div
                            class={`group relative p-8 rounded-3xl bg-brand-surface border transition-all duration-500 overflow-hidden ${starter.status === "available" ? "border-white/5 hover:border-brand-yellow/30" : "border-white/5 opacity-60"}`}
                        >
                            <div class="absolute top-0 right-0 w-48 h-48 bg-brand-yellow/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 group-hover:bg-brand-yellow/10 transition-colors duration-500" />
                            <div class="relative z-10">
                                <div class="flex items-start justify-between mb-6">
                                    <div
                                        class="w-12 h-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-white"
                                        set:html={starter.icon}
                                    />
                                    {starter.status === "coming-soon" && (
                                        <span class="px-3 py-1 text-xs font-medium rounded-full bg-brand-yellow/10 text-brand-yellow border border-brand-yellow/20">
                                            {t.starters.comingSoon}
                                        </span>
                                    )}
                                </div>
                                <h3 class="text-xl font-bold text-white mb-2 group-hover:text-brand-yellow transition-colors duration-200">
                                    {starter.name}
                                </h3>
                                <p class="text-brand-muted text-sm mb-6">
                                    {starter.description}
                                </p>
                                <div class="flex flex-wrap gap-2 mb-6">
                                    {starter.features.map((feature) => (
                                        <span class="px-2 py-1 text-xs font-medium rounded bg-white/5 text-brand-muted">
                                            {feature}
                                        </span>
                                    ))}
                                </div>
                                {starter.status === "available" ? (
                                    <a
                                        href={starter.github}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="inline-flex items-center gap-2 text-sm font-medium text-brand-yellow hover:underline"
                                    >
                                        {t.starters.viewOnGithub}
                                        <span
                                            set:html={withSize(
                                                icons.arrowRight,
                                                16,
                                            )}
                                        />
                                    </a>
                                ) : (
                                    <span class="text-sm text-brand-muted">
                                        {t.starters.availableSoon}
                                    </span>
                                )}
                            </div>
                        </div>
                    ))
                }
            </div>
        </Container>
    </section>
</ProductLayout>
