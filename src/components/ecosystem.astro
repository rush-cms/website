---
import Container from "./ui/container.astro";
import { ecosystemProducts } from "../config/nav-config";
import { icons, withSize } from "../config/icons";
import {
    useTranslations,
    getLangFromUrl,
    type Locale,
    getLocalizedPath,
} from "../i18n/utils";

interface Props {
    lang?: Locale;
}

const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const ecosystemIcons = {
    sdk: withSize(icons.terminal, 28),
    starters: withSize(icons.rocket, 28),
    audits: withSize(icons.chart, 28),
};

// Helper para obter tradução de produtos de forma segura
const getProductTranslation = (slug: string) => {
    return (t.ecosystem.products as any)[slug] || {};
};

const getCategoryTranslation = (key: string) => {
    return (t.ecosystem.categories as any)[key] || {};
};
---

<section class="py-24 sm:py-32 relative overflow-hidden">
    <div
        class="absolute inset-0 bg-linear-to-b from-transparent via-brand-yellow/5 to-transparent pointer-events-none"
    >
    </div>

    <Container class="relative z-10">
        <div class="text-center mb-16">
            <h2
                class="text-sm sm:text-base font-mono text-brand-muted uppercase tracking-widest mb-4"
            >
                {t.ecosystem.sectionTitle}
            </h2>
            <p
                class="text-3xl sm:text-4xl font-bold text-white max-w-2xl mx-auto mb-4"
            >
                {t.ecosystem.title}
            </p>
            <p class="text-brand-muted text-base sm:text-lg max-w-xl mx-auto">
                {t.ecosystem.subtitle}
            </p>
        </div>

        {
            Object.entries(ecosystemProducts).map(
                ([key, category], categoryIndex) => {
                    const catTrans = getCategoryTranslation(key);
                    return (
                        <div class={categoryIndex > 0 ? "mt-16" : ""}>
                            <div class="flex items-center gap-4 mb-8">
                                <div class="h-px flex-1 bg-linear-to-r from-transparent via-white/10 to-transparent" />
                                <h3 class="text-sm sm:text-base font-mono text-brand-muted uppercase tracking-widest">
                                    {catTrans.label || category.label}
                                </h3>
                                <div class="h-px flex-1 bg-linear-to-r from-transparent via-white/10 to-transparent" />
                            </div>

                            <p class="text-center text-brand-muted text-base sm:text-lg mb-8">
                                {catTrans.description || category.description}
                            </p>

                            <div
                                class={`grid gap-6 ${category.products.length === 1 ? "max-w-lg mx-auto" : "grid-cols-1 md:grid-cols-2"}`}
                            >
                                {category.products.map((product) => {
                                    const prodTrans = getProductTranslation(
                                        product.slug,
                                    );
                                    return (
                                        <a
                                            href={getLocalizedPath(
                                                product.href,
                                                lang,
                                            )}
                                            class="group relative p-8 rounded-3xl bg-brand-surface border border-white/5 hover:border-brand-yellow/30 transition-all duration-500 overflow-hidden"
                                        >
                                            <div class="absolute top-0 right-0 w-48 h-48 bg-brand-yellow/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 group-hover:bg-brand-yellow/10 transition-colors duration-500" />

                                            <div class="relative z-10">
                                                <div class="flex items-start justify-between mb-6">
                                                    <div class="w-14 h-14 rounded-2xl bg-brand-yellow/10 border border-brand-yellow/20 flex items-center justify-center text-brand-yellow group-hover:scale-110 group-hover:bg-brand-yellow/20 transition-all duration-300">
                                                        <span
                                                            set:html={
                                                                ecosystemIcons[
                                                                    product.slug as keyof typeof ecosystemIcons
                                                                ] ||
                                                                `<span class="text-xl font-bold">${(prodTrans.name || product.name).charAt(0)}</span>`
                                                            }
                                                        />
                                                    </div>

                                                    <span class="flex items-center gap-1 text-sm text-brand-muted group-hover:text-brand-yellow transition-colors duration-200">
                                                        {t.ecosystem.viewMore}
                                                        <span
                                                            class="group-hover:translate-x-1 transition-transform duration-200"
                                                            set:html={withSize(
                                                                icons.arrowRight,
                                                                16,
                                                            )}
                                                        />
                                                    </span>
                                                </div>

                                                <h4 class="text-2xl font-bold text-white mb-2 group-hover:text-brand-yellow transition-colors duration-200">
                                                    {prodTrans.name ||
                                                        product.name}
                                                </h4>

                                                <p class="text-brand-muted mb-6">
                                                    {prodTrans.tagline ||
                                                        product.tagline}
                                                </p>

                                                {prodTrans.badges && (
                                                    <div class="flex flex-wrap gap-2">
                                                        {prodTrans.badges.map(
                                                            (badge: string) => (
                                                                <span class="px-3 py-1 text-xs font-medium rounded-full bg-white/5 text-brand-muted border border-white/10">
                                                                    {badge}
                                                                </span>
                                                            ),
                                                        )}
                                                    </div>
                                                )}

                                                {prodTrans.features && (
                                                    <div class="flex flex-wrap gap-2">
                                                        {prodTrans.features.map(
                                                            (
                                                                feature: string,
                                                            ) => (
                                                                <span class="px-3 py-1 text-xs font-medium rounded-full bg-green-500/10 text-green-400 border border-green-500/20">
                                                                    {feature}
                                                                </span>
                                                            ),
                                                        )}
                                                    </div>
                                                )}
                                            </div>
                                        </a>
                                    );
                                })}
                            </div>
                        </div>
                    );
                },
            )
        }

        <div class="text-center mt-16">
            <a
                href="https://github.com/rush-cms"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-6 py-3 text-sm font-medium text-brand-muted hover:text-white border border-white/10 hover:border-white/20 rounded-full transition-all duration-200"
            >
                <span class="w-5 h-5" set:html={icons.github} />
                {t.ecosystem.viewAllGithub}
            </a>
        </div>
    </Container>
</section>
