---
import Container from "./ui/container.astro";
import Card from "./ui/card.astro";

const icons = {
    performance: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path></svg>`, // Zap
    security: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>`, // Lock
    nolockin: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12V7a5 5 0 0 0-9.9-1"></path><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect></svg>`, // Unlock/Open
    analytics: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>`, // BarChart
    dynamic: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><line x1="9" y1="20" x2="9" y2="23"></line><line x1="15" y1="20" x2="15" y2="23"></line><line x1="20" y1="9" x2="23" y2="9"></line><line x1="20" y1="14" x2="23" y2="14"></line><line x1="1" y1="9" x2="4" y2="9"></line><line x1="1" y1="14" x2="4" y2="14"></line></svg>`, // CPU/Chip
    deploy: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 9.5 2 12l2.5 2.5"/><path d="m19.5 9.5 2.5 2.5-2.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>`, // Code/Terminal? Using a generic rocket might be cliché but requested. Let's use Rocket for deploy per common UI.
};

const rocketIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path></svg>`;

const features = [
    {
        title: "Performance extrema",
        description:
            "API otimizada com cache inteligente, queries eficientes e infraestrutura em bare metal. Sites carregam em menos de 2 segundos.",
        icon: icons.performance,
    },
    {
        title: "Segurança de verdade",
        description:
            "Backups automáticos, SSL, isolamento de dados por tenant, e conformidade com LGPD. Seus dados nunca saem do Brasil.",
        icon: icons.security,
    },
    {
        title: "Sem vendor lock-in",
        description:
            "Exportação completa de dados a qualquer momento. Se quiser sair, seu site e conteúdo continuam funcionando.",
        icon: icons.nolockin,
    },
    {
        title: "Analytics integrado",
        description:
            "Métricas de acesso sem depender do Google. Leve, privado, e em conformidade com regulamentações.",
        icon: icons.analytics,
    },
    {
        title: "Campos dinâmicos",
        description:
            "Crie coleções com os campos que precisar: texto, imagem, galeria, vídeo, arquivo, repeater, blocos customizados.",
        icon: icons.dynamic,
    },
    {
        title: "Deploy otimizado",
        description:
            "Infraestrutura própria em Hetzner + Cloudflare. Nada de cold starts ou limites arbitrários.",
        icon: rocketIcon,
    },
];
---

<section id="servicos" class="py-24 sm:py-32 relative">
    <Container>
        <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8"
        >
            <h2 class="sr-only">Principais recursos</h2>
            {
                features.map((feature) => (
                    <Card
                        title={feature.title}
                        description={feature.description}
                    >
                        <span slot="icon" set:html={feature.icon} />
                    </Card>
                ))
            }
        </div>
    </Container>
</section>
