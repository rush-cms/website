---
import Container from "./ui/container.astro";
import Card from "./ui/card.astro";
import { icons, withSize } from "../config/icons";
import { useTranslations, getLangFromUrl, type Locale } from "../i18n/utils";

interface Props {
    lang?: Locale;
}

const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const heroFeatures = [
    {
        title: t.features.contentEditor.title,
        subtitle: t.features.contentEditor.subtitle,
        description: t.features.contentEditor.description,
        highlights: t.features.contentEditor.highlights,
        icon: withSize(icons.edit, 28),
    },
    {
        title: t.features.blockBuilder.title,
        subtitle: t.features.blockBuilder.subtitle,
        description: t.features.blockBuilder.description,
        highlights: t.features.blockBuilder.highlights,
        icon: withSize(icons.blocks, 28),
    },
    {
        title: t.features.database.title,
        subtitle: t.features.database.subtitle,
        description: t.features.database.description,
        highlights: t.features.database.highlights,
        icon: withSize(icons.database, 28),
    },
];

const gridFeatures = [
    {
        title: t.features.formBuilder.title,
        description: t.features.formBuilder.description,
        icon: withSize(icons.edit, 24),
    },
    {
        title: t.features.multiTenancy.title,
        description: t.features.multiTenancy.description,
        icon: withSize(icons.users, 24),
    },
    {
        title: t.features.wpImporter.title,
        description: t.features.wpImporter.description,
        icon: withSize(icons.download, 24),
    },
    {
        title: t.features.permissions.title,
        description: t.features.permissions.description,
        icon: withSize(icons.settings, 24),
    },
    {
        title: t.features.templates.title,
        description: t.features.templates.description,
        icon: withSize(icons.template, 24),
    },
    {
        title: t.features.api.title,
        description: t.features.api.description,
        icon: withSize(icons.api, 24),
    },
];
---

<section id="servicos" class="py-24 sm:py-32 relative">
    <Container>
        <div class="text-center mb-16">
            <h2
                class="text-sm sm:text-base font-mono text-brand-muted uppercase tracking-widest mb-4"
            >
                {t.features.sectionTitle}
            </h2>
            <p
                class="text-3xl sm:text-4xl font-bold text-white max-w-2xl mx-auto"
            >
                {t.features.sectionSubtitle}
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-12">
            {
                heroFeatures.map((feature) => (
                    <div class="group relative p-8 rounded-3xl bg-linear-to-br from-brand-surface to-brand-surface/50 border border-white/5 hover:border-brand-yellow/30 transition-all duration-500 overflow-hidden">
                        <div class="absolute top-0 right-0 w-64 h-64 bg-brand-yellow/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 group-hover:bg-brand-yellow/10 transition-colors duration-500" />

                        <div class="relative z-10">
                            <div class="w-14 h-14 rounded-2xl bg-brand-yellow/10 border border-brand-yellow/20 flex items-center justify-center mb-6 text-brand-yellow group-hover:scale-110 group-hover:bg-brand-yellow/20 transition-all duration-300">
                                <span set:html={feature.icon} />
                            </div>

                            <div class="mb-4">
                                <h3 class="text-2xl font-bold text-white mb-1 group-hover:text-brand-yellow transition-colors duration-200">
                                    {feature.title}
                                </h3>
                                <p class="text-brand-yellow/80 font-medium">
                                    {feature.subtitle}
                                </p>
                            </div>

                            <p class="text-brand-muted leading-relaxed mb-6">
                                {feature.description}
                            </p>

                            <div class="flex flex-wrap gap-2">
                                {feature.highlights.map((highlight) => (
                                    <span class="px-3 py-1 text-xs font-medium rounded-full bg-white/5 text-brand-muted border border-white/10">
                                        {highlight}
                                    </span>
                                ))}
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <h2 class="sr-only">
                {lang === "en" ? "Additional features" : "Recursos adicionais"}
            </h2>
            {
                gridFeatures.map((feature) => (
                    <Card
                        title={feature.title}
                        description={feature.description}
                    >
                        <span slot="icon" set:html={feature.icon} />
                    </Card>
                ))
            }
        </div>
    </Container>
</section>
