---
interface Props {
    title: string;
    description: string;
    icon?: string;
}

const { title, description, icon } = Astro.props;
---

<div class="p-6 rounded-2xl bg-brand-surface border border-white/5">
    {
        icon && (
            <div
                class="w-10 h-10 rounded-lg bg-brand-yellow/10 border border-brand-yellow/20 flex items-center justify-center mb-4 text-brand-yellow"
                set:html={icon}
            />
        )
    }
    <h3 class="text-lg font-semibold text-white mb-2">
        {title}
    </h3>
    <p class="text-sm text-brand-muted">
        {description}
    </p>
</div>
