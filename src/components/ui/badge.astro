---
interface Props {
    class?: string;
}
const { class: className } = Astro.props;
---

<span
    class:list={[
        "inline-flex items-center px-3 py-2 rounded-md text-xs font-medium bg-brand-yellow/10 text-brand-yellow border border-brand-yellow/20 backdrop-blur-sm tracking-wide",
        className,
    ]}
>
    <slot />
</span>
