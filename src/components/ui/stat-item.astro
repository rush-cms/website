---
interface Props {
    value: string;
    label: string;
}

const { value, label } = Astro.props;
---

<div class="flex flex-col items-center">
    <dt
        class="text-4xl sm:text-5xl font-bold text-brand-yellow font-mono mb-2 tracking-tighter"
    >
        {value}
    </dt>
    <dd class="text-sm sm:text-base text-brand-muted font-medium">
        {label}
    </dd>
</div>
