---
interface Props {
    title: string;
    description: string;
    icon?: string;
}

const { title, description } = Astro.props;
---

<div
    class="group p-8 rounded-2xl bg-brand-surface border border-white/5 hover:border-brand-yellow/30 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-brand-yellow/5"
>
    <div
        class="w-12 h-12 rounded-lg bg-brand-dark border border-white/10 flex items-center justify-center mb-6 text-2xl group-hover:scale-110 group-hover:border-brand-yellow/50 transition-all duration-300"
    >
        <slot name="icon" />
    </div>

    <h3
        class="text-xl font-bold text-white mb-3 group-hover:text-brand-yellow transition-colors duration-200"
    >
        {title}
    </h3>

    <p class="text-brand-muted leading-relaxed text-sm sm:text-base">
        {description}
    </p>
</div>
