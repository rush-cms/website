---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
    variant?: "primary" | "secondary" | "outline" | "ghost";
    size?: "sm" | "md" | "lg";
    href?: string;
    type?: "button" | "submit" | "reset";
    class?: string;
}

const {
    variant = "primary",
    size = "md",
    class: className,
    href,
    type,
    ...props
} = Astro.props;

const variants = {
    primary:
        "bg-brand-yellow text-brand-dark hover:bg-brand-yellow-hover shadow-[0_0_20px_-5px_rgba(247,255,0,0.5)] font-bold border border-transparent",
    secondary:
        "bg-brand-surface text-brand-text hover:bg-surface-hover font-medium border border-white/10",
    outline:
        "bg-transparent border border-brand-yellow text-brand-yellow hover:bg-brand-yellow/10 font-medium",
    ghost: "bg-transparent text-brand-muted hover:text-brand-text hover:bg-white/5 font-medium",
};

const sizes = {
    sm: "px-4 py-2 text-sm",
    md: "px-6 py-3 text-base",
    lg: "px-8 py-4 text-lg",
};

const Element = href ? "a" : "button";
---

<Element
    href={href}
    type={!href ? type : undefined}
    class:list={[
        "inline-flex items-center justify-center rounded-lg transition-all duration-200 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed",
        variants[variant],
        sizes[size],
        className,
    ]}
    {...props}
>
    <slot />
</Element>
