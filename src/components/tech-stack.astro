---

<section class="py-20 text-center">
    <Container>
        <h2
            class="text-sm sm:text-base font-mono text-brand-muted uppercase tracking-widest mb-10"
        >
            {t.techStack.builtWith}
        </h2>

        <div class="flex flex-wrap justify-center items-center gap-4 sm:gap-6">
            {
                technologies.map((tech) => (
                    <div class="flex items-center gap-3 px-5 py-3 rounded-full bg-white/3 border border-white/5 hover:border-white/10 transition-colors duration-300 group">
                        <div
                            class="w-6 h-6 flex items-center justify-center transition-transform duration-300 group-hover:scale-110"
                            set:html={tech.icon}
                        />
                        <span class="text-sm font-medium text-gray-300">
                            {tech.name}
                        </span>
                    </div>
                ))
            }
        </div>
    </Container>
</section>
