---
import Container from "./ui/container.astro";
import Badge from "./ui/badge.astro";
import LanguageSwitcher from "./ui/language-switcher.astro";
import { ecosystemProducts } from "../config/nav-config";
import { icons } from "../config/icons";
import {
    useTranslations,
    getLangFromUrl,
    type Locale,
    getLocalizedPath,
} from "../i18n/utils";

interface Props {
    currentVersion?: string;
    lang?: Locale;
}

const { currentVersion = "beta 0.5" } = Astro.props;
const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const getCategoryTranslation = (key: string) => {
    return (t.ecosystem.categories as any)[key] || {};
};

const getProductTranslation = (slug: string) => {
    return (t.ecosystem.products as any)[slug] || {};
};
---

<header class="absolute top-0 left-0 w-full z-50 py-6">
    <Container>
        <div class="flex items-center justify-between">
            <a
                href={getLocalizedPath("/", lang)}
                class="flex items-center gap-2 group"
                aria-label="Rush CMS Home"
            >
                <img
                    src="/favicon.svg"
                    alt="Rush CMS Logo"
                    class="w-8 h-8 group-hover:scale-105 transition-transform duration-200"
                />
                <span class="font-bold text-xl tracking-tight text-white"
                    >Rush <span class="text-brand-muted font-normal">CMS</span
                    ></span
                >
            </a>

            <div class="hidden md:flex items-center gap-6">
                <nav class="flex items-center gap-1">
                    <div class="relative group">
                        <button
                            type="button"
                            class="flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-brand-muted hover:text-white transition-colors duration-200"
                            aria-expanded="false"
                            aria-haspopup="true"
                        >
                            {t.nav.ecosystem}
                            <svg
                                class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180"
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="m6 9 6 6 6-6"></path>
                            </svg>
                        </button>

                        <div
                            class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200"
                        >
                            <div
                                class="w-72 p-2 rounded-xl bg-brand-surface border border-white/10 shadow-2xl shadow-black/50"
                            >
                                {
                                    Object.entries(ecosystemProducts).map(
                                        ([key, category]) => {
                                            const catTrans =
                                                getCategoryTranslation(key);
                                            return (
                                                <div class="mb-2 last:mb-0">
                                                    <p class="px-3 py-1.5 text-xs font-medium text-brand-muted uppercase tracking-wider">
                                                        {catTrans.label ||
                                                            category.label}
                                                    </p>
                                                    {category.products.map(
                                                        (product) => {
                                                            const prodTrans =
                                                                getProductTranslation(
                                                                    product.slug,
                                                                );
                                                            return (
                                                                <a
                                                                    href={getLocalizedPath(
                                                                        product.href,
                                                                        lang,
                                                                    )}
                                                                    class="flex items-start gap-3 px-3 py-2.5 rounded-lg hover:bg-white/5 transition-colors duration-200 group/item"
                                                                >
                                                                    <div class="w-8 h-8 rounded-lg bg-brand-yellow/10 border border-brand-yellow/20 flex items-center justify-center shrink-0 group-hover/item:scale-105 transition-transform duration-200">
                                                                        <span class="text-brand-yellow text-sm font-bold">
                                                                            {product.name.charAt(
                                                                                0,
                                                                            )}
                                                                        </span>
                                                                    </div>
                                                                    <div>
                                                                        <p class="text-sm font-medium text-white group-hover/item:text-brand-yellow transition-colors duration-200">
                                                                            {prodTrans.name ||
                                                                                product.name}
                                                                        </p>
                                                                        <p class="text-xs text-brand-muted">
                                                                            {prodTrans.tagline ||
                                                                                product.tagline}
                                                                        </p>
                                                                    </div>
                                                                </a>
                                                            );
                                                        },
                                                    )}
                                                </div>
                                            );
                                        },
                                    )
                                }

                                <div class="mt-2 pt-2 border-t border-white/5">
                                    <a
                                        href="https://github.com/rush-cms"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="flex items-center gap-2 px-3 py-2 text-xs text-brand-muted hover:text-white transition-colors duration-200"
                                    >
                                        <svg
                                            class="w-4 h-4"
                                            xmlns="http://www.w3.org/2000/svg"
                                            viewBox="0 0 24 24"
                                            fill="currentColor"
                                        >
                                            <path
                                                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                                            ></path>
                                        </svg>
                                        {t.ecosystem.viewAllGithub}
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <a
                        href="https://github.com/rush-cms/docs"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="px-3 py-2 text-sm font-medium text-brand-muted hover:text-white transition-colors duration-200"
                    >
                        {t.nav.docs}
                    </a>
                </nav>

                <div class="flex items-center gap-2">
                    <LanguageSwitcher lang={lang} />

                    <a
                        href="https://github.com/rush-cms"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="p-2 text-brand-muted hover:text-white transition-colors duration-200"
                        aria-label="GitHub"
                    >
                        <span class="w-5 h-5" set:html={icons.github} />
                    </a>

                    <Badge
                        class="border-green-500/30 text-green-400 bg-green-500/10"
                    >
                        <span
                            class="w-1.5 h-1.5 rounded-full bg-green-400 mr-2 animate-pulse"
                        ></span>
                        {currentVersion}
                    </Badge>
                </div>
            </div>

            <button
                type="button"
                class="md:hidden p-2 text-brand-muted hover:text-white transition-colors duration-200"
                aria-label="Abrir menu"
                id="mobile-menu-button"
            >
                <svg
                    class="w-6 h-6"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <line x1="4" x2="20" y1="12" y2="12"></line>
                    <line x1="4" x2="20" y1="6" y2="6"></line>
                    <line x1="4" x2="20" y1="18" y2="18"></line>
                </svg>
            </button>
        </div>
    </Container>
</header>

<div
    id="mobile-menu"
    class="fixed inset-0 z-50 bg-brand-dark/95 backdrop-blur-lg opacity-0 invisible transition-all duration-300 md:hidden"
>
    <div class="flex flex-col h-full pt-20 pb-8 px-6">
        <a
            href={getLocalizedPath("/", lang)}
            class="absolute top-6 left-6 flex items-center gap-2 group"
            aria-label="Rush CMS Home"
        >
            <img
                src="/favicon.svg"
                alt="Rush CMS Logo"
                class="w-8 h-8 group-hover:scale-105 transition-transform duration-200"
            />
            <span class="font-bold text-xl tracking-tight text-white"
                >Rush <span class="text-brand-muted font-normal">CMS</span
                ></span
            >
        </a>

        <button
            type="button"
            class="absolute top-6 right-6 p-2 text-brand-muted hover:text-white transition-colors duration-200"
            aria-label="Fechar menu"
            id="mobile-menu-close"
        >
            <svg
                class="w-6 h-6"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M18 6 6 18"></path>
                <path d="m6 6 12 12"></path>
            </svg>
        </button>

        <nav class="flex-1 space-y-6">
            {
                Object.entries(ecosystemProducts).map(([key, category]) => {
                    const catTrans = getCategoryTranslation(key);
                    return (
                        <div>
                            <p class="text-xs font-medium text-brand-muted uppercase tracking-wider mb-3">
                                {catTrans.label || category.label}
                            </p>
                            <div class="space-y-1">
                                {category.products.map((product) => {
                                    const prodTrans = getProductTranslation(
                                        product.slug,
                                    );
                                    return (
                                        <a
                                            href={getLocalizedPath(
                                                product.href,
                                                lang,
                                            )}
                                            class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-white/5 transition-colors duration-200"
                                        >
                                            <div class="w-10 h-10 rounded-lg bg-brand-yellow/10 border border-brand-yellow/20 flex items-center justify-center">
                                                <span class="text-brand-yellow font-bold">
                                                    {product.name.charAt(0)}
                                                </span>
                                            </div>
                                            <div>
                                                <p class="font-medium text-white">
                                                    {prodTrans.name ||
                                                        product.name}
                                                </p>
                                                <p class="text-sm text-brand-muted">
                                                    {prodTrans.tagline ||
                                                        product.tagline}
                                                </p>
                                            </div>
                                        </a>
                                    );
                                })}
                            </div>
                        </div>
                    );
                })
            }

            <div>
                <p
                    class="text-xs font-medium text-brand-muted uppercase tracking-wider mb-3"
                >
                    Links
                </p>
                <a
                    href="https://github.com/rush-cms/docs"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-white/5 transition-colors duration-200"
                >
                    <div
                        class="w-10 h-10 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center"
                    >
                        <svg
                            class="w-5 h-5 text-white"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path
                                d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"
                            ></path>
                        </svg>
                    </div>
                    <div>
                        <p class="font-medium text-white">{t.nav.docs}</p>
                        <p class="text-sm text-brand-muted">
                            {t.productLayout.documentation}
                        </p>
                    </div>
                </a>
            </div>
        </nav>

        <a
            href="https://github.com/rush-cms"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-white/5 border border-white/10 text-white font-medium hover:bg-white/10 transition-colors duration-200"
        >
            <svg
                class="w-5 h-5"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
            >
                <path
                    d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                ></path>
            </svg>
            {t.productLayout.viewOnGithub}
        </a>
    </div>
</div>

<script>
    const mobileMenuButton = document.getElementById("mobile-menu-button");
    const mobileMenuClose = document.getElementById("mobile-menu-close");
    const mobileMenu = document.getElementById("mobile-menu");

    function openMenu() {
        mobileMenu?.classList.remove("opacity-0", "invisible");
        mobileMenu?.classList.add("opacity-100", "visible");
        document.body.style.overflow = "hidden";
    }

    function closeMenu() {
        mobileMenu?.classList.add("opacity-0", "invisible");
        mobileMenu?.classList.remove("opacity-100", "visible");
        document.body.style.overflow = "";
    }

    mobileMenuButton?.addEventListener("click", openMenu);
    mobileMenuClose?.addEventListener("click", closeMenu);

    mobileMenu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", closeMenu);
    });
</script>
