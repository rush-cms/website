---
import Container from "./ui/container.astro";
import Button from "./ui/button.astro";
import CodeWindow from "./code-window.astro";
import GlowEffect from "./ui/glow-effect.astro";
import { icons } from "../config/icons";
import { useTranslations, getLangFromUrl, type Locale } from "../i18n/utils";

interface Props {
    lang?: Locale;
}

const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden">
    <GlowEffect />

    <Container class="relative z-10">
        <div class="flex flex-col items-center text-center">
            <h1
                class="max-w-4xl mx-auto text-5xl sm:text-6xl lg:text-7xl font-bold tracking-tight mb-8 animate-fade-in-up"
                style="animation-delay: 0.2s;"
            >
                {
                    lang === "pt-BR" ? (
                        <>
                            Backend poderoso para <br class="hidden sm:block" />
                            <span class="text-brand-yellow">
                                sites de alta performance
                            </span>
                        </>
                    ) : (
                        <>
                            Powerful backend for <br class="hidden sm:block" />
                            <span class="text-brand-yellow">
                                high-performance websites
                            </span>
                        </>
                    )
                }
            </h1>

            <p
                class="max-w-xl mx-auto text-lg sm:text-xl text-brand-muted mb-10 leading-relaxed animate-fade-in-up"
                style="animation-delay: 0.3s;"
            >
                {t.hero.subtitle.split("Sem vendor lock-in.")[0]}
                <span class="text-white"
                    >{
                        lang === "pt-BR"
                            ? "Sem vendor lock-in."
                            : "No vendor lock-in."
                    }</span
                >
            </p>

            <div
                class="flex flex-col sm:flex-row items-center gap-4 mb-20 animate-fade-in-up"
                style="animation-delay: 0.4s;"
            >
                <Button
                    href="#servicos"
                    variant="primary"
                    size="lg"
                    class="w-full sm:w-auto"
                >
                    {t.hero.cta}
                    <span class="w-5 h-5 ml-2" set:html={icons.arrowRight} />
                </Button>

                <Button
                    href="https://github.com/rush-cms"
                    variant="secondary"
                    size="lg"
                    class="w-full sm:w-auto gap-2"
                >
                    <span class="w-5 h-5" set:html={icons.github} />
                    {t.hero.ctaSecondary}
                </Button>
            </div>

            <div
                class="w-full animate-fade-in-up"
                style="animation-delay: 0.5s;"
            >
                <CodeWindow />
            </div>
        </div>
    </Container>
</section>

<style>
    @keyframes fade-in-up {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-in-up {
        animation: fade-in-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
    }
</style>
