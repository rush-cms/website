---

---

<div
    class="relative w-full max-w-2xl xl:max-w-4xl mx-auto rounded-xl bg-code-bg border border-white/10 shadow-2xl overflow-hidden font-mono text-sm sm:text-base group hover:border-white/20 transition-colors duration-300"
>
    <div
        class="flex items-center gap-2 px-4 py-3 bg-white/5 border-b border-white/5"
    >
        <div class="w-3 h-3 rounded-full bg-mac-red"></div>
        <div class="w-3 h-3 rounded-full bg-mac-yellow"></div>
        <div class="w-3 h-3 rounded-full bg-mac-green"></div>
        <div class="ml-2 text-xs text-white/30 select-none">api-example.ts</div>
    </div>

    <div class="p-6 overflow-x-auto text-gray-300 leading-relaxed">
        <div class="flex">
            <span class="w-6 text-white/20 select-none text-right mr-4">1</span>
            <span class="text-brand-muted"
                >// Buscar entradas de uma coleção</span
            >
        </div>
        <div class="flex">
            <span class="w-6 text-white/20 select-none text-right mr-4">2</span>
            <span>
                <span class="text-purple-400">const</span>
                <span class="text-blue-400">about</span> = <span
                    class="text-purple-400">await</span
                > rushcms.<span class="text-blue-300">getEntries</span>(<span
                    class="text-yellow-300">&#123;</span
                >
            </span>
        </div>
        <div class="flex">
            <span class="w-6 text-white/20 select-none text-right mr-4">3</span>
            <span class="pl-4">
                <span class="text-red-400">collection</span>: <span
                    class="text-green-400">'portfolios'</span
                >,
            </span>
        </div>
        <div class="flex">
            <span class="w-6 text-white/20 select-none text-right mr-4">4</span>
            <span class="pl-4">
                <span class="text-red-400">limit</span>: <span
                    class="text-orange-400">10</span
                >,
            </span>
        </div>
        <div class="flex">
            <span class="w-6 text-white/20 select-none text-right mr-4">5</span>
            <span class="pl-4">
                <span class="text-red-400">orderBy</span>: <span
                    class="text-green-400">'created_at'</span
                >
            </span>
        </div>
        <div class="flex">
            <span class="w-6 text-white/20 select-none text-right mr-4">6</span>
            <span><span class="text-yellow-300">&#125;</span>)</span>
        </div>
        <div class="flex">
            <span class="w-6 text-white/20 select-none text-right mr-4">7</span>
            <span></span>
        </div>
        <div class="flex">
            <span class="w-6 text-white/20 select-none text-right mr-4">8</span>
            <span class="text-brand-muted"
                >// Response time: &lt;45ms | PageSpeed: 🚀</span
            >
        </div>
    </div>

    <div
        class="absolute -top-20 -right-20 w-40 h-40 bg-brand-yellow/5 blurred-full rounded-full pointer-events-none blur-3xl"
    >
    </div>
</div>
