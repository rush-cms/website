---
import Container from "./ui/container.astro";
import { useTranslations, getLangFromUrl, type Locale } from "../i18n/utils";

interface Props {
    lang?: Locale;
}

const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="py-12 border-t border-white/5 bg-footer-bg">
    <Container>
        <div
            class="flex flex-col md:flex-row items-center justify-between gap-6"
        >
            <div class="flex items-center gap-2">
                <img src="/favicon.svg" alt="Rush CMS Logo" class="w-6 h-6" />
                <span class="font-bold text-lg tracking-tight text-white"
                    >Rush <span class="text-brand-muted font-normal">CMS</span
                    ></span
                >
            </div>

            <p class="text-xs text-brand-muted flex items-center gap-2">
                &copy; {new Date().getFullYear()} Rush CMS
                <span class="text-brand-muted">|</span>
                <a
                    href="https://rafhael.com.br?utm_source=rush-cms&utm_medium=footer&utm_campaign=website"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-2"
                >
                    {t.footer.developedBy}
                    <img
                        src="/rafhael-logo.svg"
                        alt="Rafhael Marsigli"
                        class="w-8 h-8 hover:shadow-xl transition-shadow duration-200"
                    />
                </a>
            </p>
        </div>
    </Container>
</footer>
