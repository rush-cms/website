---
import Container from "./ui/container.astro";
import Badge from "./ui/badge.astro";
import Button from "./ui/button.astro";
---

<section class="py-20 lg:py-32">
    <Container>
        <div
            class="relative rounded-3xl overflow-hidden bg-brand-surface border border-white/5 p-8 sm:p-16 text-center"
        >
            <div
                class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full max-w-3xl pointer-events-none opacity-20"
            >
                <div
                    class="absolute inset-0 bg-gradient-to-b from-brand-yellow/10 to-transparent blur-3xl"
                >
                </div>
            </div>

            <div
                class="relative z-10 max-w-4xl mx-auto flex flex-col items-center"
            >
                <Badge
                    class="mb-8 border-yellow-500/30 text-yellow-400 bg-yellow-500/10"
                >
                    Plataforma Fechada
                </Badge>

                <h2
                    class="text-3xl sm:text-4xl md:text-5xl font-bold mb-6 text-brand-yellow tracking-tight"
                >
                    Disponível exclusivamente para clientes selecionados
                </h2>

                <p class="text-brand-muted text-lg mb-10 leading-relaxed">
                    Rush CMS não é vendido separadamente. Está incluso nos
                    serviços de criação de sites de alta performance oferecidos
                    por Rafhael Marsigli.
                </p>

                <Button
                    href="https://rafhael.com.br"
                    class="bg-white text-brand-dark hover:bg-gray-200"
                >
                    Ver serviços disponíveis
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-4 h-4 ml-2"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M5 12h14M12 5l7 7-7 7"></path></svg
                    >
                </Button>

                <p class="mt-8 text-xs text-brand-muted/60">
                    Interessado na tecnologia? Entre em contato para saber mais.
                </p>
            </div>
        </div>
    </Container>
</section>
