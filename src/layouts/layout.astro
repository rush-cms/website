---
interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "Rush CMS - Backend poderoso para sites de alta performance",
} = Astro.props;
import SeoHead from "../components/seo/seo-head.astro";
import "../styles/app.css";
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
    <head>
        <SeoHead title={title} description={description} />
    </head>
    <body
        class="antialiased bg-brand-dark text-brand-text overflow-x-hidden selection:bg-brand-yellow selection:text-brand-dark relative"
    >
        <div class="bg-grid"></div>
        <div class="bg-glow"></div>
        <slot />
    </body>
</html>
