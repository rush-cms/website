---
interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "Rush CMS - Backend poderoso para sites de alta performance",
} = Astro.props;
import "../styles/app.css";
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <meta property="og:image" content="/banner.svg" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <title>{title}</title>
    </head>
    <body
        class="antialiased bg-brand-dark text-brand-text overflow-x-hidden selection:bg-brand-yellow selection:text-brand-dark relative"
    >
        <div class="bg-grid"></div>
        <div class="bg-glow"></div>
        <slot />
    </body>
</html>
